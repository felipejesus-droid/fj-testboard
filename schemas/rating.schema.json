{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rating.schema.json",
  "title": "rating",
  "type": "object",
  "required": ["blind_id", "rater", "scores", "approved", "approved_override_reason", "minutes_to_publishable", "notes", "rated_at"],
  "additionalProperties": false,
  "properties": {
    "blind_id": { "type": "string", "pattern": "^[a-f0-9]{6}$" },
    "rater": { "type": "string", "minLength": 2 },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["c1", "c2", "c3", "c4", "c5"],
      "properties": {
        "c1": { "type": "integer", "minimum": 0, "maximum": 5 },
        "c2": { "type": "integer", "minimum": 0, "maximum": 5 },
        "c3": { "type": "integer", "minimum": 0, "maximum": 5 },
        "c4": { "type": "integer", "minimum": 0, "maximum": 5 },
        "c5": { "type": "integer", "minimum": 0, "maximum": 5 }
      }
    },
    "approved": { "type": "boolean" },
    "approved_override_reason": { "type": ["string", "null"] },
    "minutes_to_publishable": { "type": ["number", "null"], "minimum": 0 },
    "notes": { "type": "string" },
    "rated_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$" }
  }
}
