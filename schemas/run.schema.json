{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run.schema.json",
  "title": "run",
  "type": "object",
  "required": ["delivery_id", "round_id", "task_id", "task_version", "prompt_sha256", "model", "date", "tools_enabled", "tools_actually_used", "attempt", "output_dir", "tokens_in", "tokens_out", "cost_brl", "duration_s", "status_envelope", "auto_checks", "blind_id", "visibility"],
  "additionalProperties": false,
  "properties": {
    "delivery_id": { "type": "string", "pattern": "^T(0[1-9]|1[0-2])__[a-z0-9-]+__a[0-9]+$" },
    "round_id": { "type": "string", "pattern": "^R[0-9]{3}(-selftest|b)?$" },
    "task_id": { "type": "string", "pattern": "^T(0[1-9]|1[0-2])$" },
    "task_version": { "type": "integer", "minimum": 1 },
    "prompt_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "model": {
      "type": "object",
      "required": ["vendor", "name", "version_label", "access"],
      "additionalProperties": false,
      "properties": {
        "vendor": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version_label": { "type": ["string", "null"] },
        "access": { "type": "string", "enum": ["manual", "api"] }
      }
    },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$" },
    "tools_enabled": { "type": "object", "properties": { "web_search": { "type": "boolean" }, "code_exec": { "type": "boolean" } }, "required": ["web_search", "code_exec"], "additionalProperties": false },
    "tools_actually_used": { "type": "array", "items": { "type": "string" } },
    "attempt": { "type": "integer", "minimum": 1 },
    "output_dir": { "type": "string", "minLength": 1 },
    "tokens_in": { "type": ["integer", "null"], "minimum": 0 },
    "tokens_out": { "type": ["integer", "null"], "minimum": 0 },
    "cost_brl": { "type": ["number", "null"], "minimum": 0 },
    "duration_s": { "type": ["integer", "null"], "minimum": 0 },
    "status_envelope": {
      "type": "object",
      "required": ["status", "summary"],
      "properties": {
        "status": { "type": "string", "enum": ["success", "warning", "error"] },
        "summary": { "type": "string" }
      }
    },
    "auto_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "pass", "detail"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["hard", "soft"] },
          "pass": { "type": "boolean" },
          "detail": { "type": "string" }
        }
      }
    },
    "blind_id": { "type": "string", "pattern": "^[a-f0-9]{6}$" },
    "visibility": { "const": "internal" }
  }
}
