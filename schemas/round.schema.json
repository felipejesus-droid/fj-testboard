{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "round.schema.json",
  "title": "round",
  "type": "object",
  "required": ["id", "created_at", "models", "tasks", "attempts", "notes"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^R[0-9]{3}(-selftest|b)?$" },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$" },
    "models": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "tasks": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^T(0[1-9]|1[0-2])$" } },
    "attempts": { "type": "integer", "minimum": 1, "maximum": 10 },
    "notes": { "type": "string" }
  }
}
