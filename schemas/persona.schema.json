{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "persona.schema.json",
  "title": "persona",
  "type": "object",
  "required": ["id", "company_name", "segment", "city", "size", "digital_maturity", "tools_in_use", "pain_points", "brand_tone", "brand_colors", "kpi_csv", "interview_notes", "owner_professional", "visibility"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^P[1-5]$" },
    "company_name": { "type": "string", "minLength": 3 },
    "segment": { "type": "string", "minLength": 3 },
    "city": { "type": "string", "minLength": 2 },
    "size": { "type": "string", "enum": ["autonomo", "micro", "pequena", "media"] },
    "digital_maturity": { "type": "integer", "minimum": 1, "maximum": 4 },
    "maturity_reason": { "type": "string", "minLength": 10 },
    "tools_in_use": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "pain_points": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 10 } },
    "brand_tone": { "type": "string", "minLength": 10 },
    "brand_colors": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "kpi_csv": { "type": "string", "pattern": "kpis\\.csv$" },
    "interview_notes": { "type": "string", "pattern": "interview_notes\\.md$" },
    "owner_professional": {
      "type": "object",
      "required": ["name", "specialty", "audience", "goals"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 3 },
        "specialty": { "type": "string", "minLength": 3 },
        "audience": { "type": "string", "minLength": 3 },
        "goals": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 10 } }
      }
    },
    "visibility": { "const": "internal" }
  }
}
