{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-card.schema.json",
  "title": "task-card",
  "type": "object",
  "required": ["id", "version", "family", "category", "persona_id", "title", "frozen_prompt_pt", "input_files", "tools", "max_revisions", "attempts_default", "output_spec", "checks", "weights", "visibility"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^T(0[1-9]|1[0-2])$" },
    "version": { "type": "integer", "minimum": 1 },
    "family": { "type": "string", "enum": ["diagnostico", "prd", "capacitacao", "apresentacao", "social", "pwa"] },
    "category": { "type": "string", "enum": ["A1", "A2", "A3", "B1", "B2", "C"] },
    "persona_id": { "type": ["string", "null"], "pattern": "^P[1-5]$" },
    "title": { "type": "string", "minLength": 8 },
    "frozen_prompt_pt": { "type": "string", "minLength": 200 },
    "input_files": { "type": "array", "items": { "type": "string" } },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["web_search", "code_exec"],
      "properties": { "web_search": { "type": "boolean" }, "code_exec": { "type": "boolean" } }
    },
    "max_revisions": { "type": "integer", "minimum": 0, "default": 1 },
    "attempts_default": { "type": "integer", "minimum": 1, "default": 1 },
    "output_spec": {
      "type": "object",
      "required": ["kind", "files"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["markdown", "markdown+csv", "web", "web-multifile"] },
        "files": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "checks": {
      "type": "object",
      "required": ["hard", "soft"],
      "additionalProperties": false,
      "properties": {
        "hard": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "soft": { "type": "array", "minItems": 2, "items": { "type": "string" } }
      }
    },
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["c1", "c2", "c3", "c4", "c5"],
      "properties": {
        "c1": { "type": "number", "minimum": 0.1, "maximum": 0.4 },
        "c2": { "type": "number", "minimum": 0.1, "maximum": 0.4 },
        "c3": { "type": "number", "minimum": 0.1, "maximum": 0.4 },
        "c4": { "type": "number", "minimum": 0.1, "maximum": 0.4 },
        "c5": { "type": "number", "minimum": 0.1, "maximum": 0.4 }
      }
    },
    "visibility": { "const": "internal" }
  }
}
